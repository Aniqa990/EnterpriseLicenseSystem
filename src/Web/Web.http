# POST Users Register
POST {{Web_HostAddress}}/api/register
Content-Type: application/json

{
  "email": "admin@company.com",
  "password": "Admin123!"
}

###

# POST Users Login
POST {{Web_HostAddress}}/api/login
Content-Type: application/json

{
  "email": "manager@company.com",
  "password": "Manager123!"
}
###
# POST Assign Role (Admin only)
# MapIdentityApi routes group this under /api/Users or /users depending on MapEndpoints setup
POST {{Web_HostAddress}}/api/Users/assign-role
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "userId": "TARGET_USER_ID_HERE",
  "role": "LicenseManager"
}

###

# POST Users Refresh
POST {{Web_HostAddress}}/api/Users/Refresh
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "refreshToken": ""
}

###

# POST Create a Software License (Admin/LicenseManager only)
POST {{Web_HostAddress}}/api/SoftwareLicenses
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "name": "JetBrains ReSharper",
  "licenseKey": "JB-2026-000123",
  "totalSeats": 5,
  "expirationDate": "2027-01-01T00:00:00Z"
}

###

# GET Software Licenses (paginated)
GET {{Web_HostAddress}}/api/SoftwareLicenses?PageNumber=1&PageSize=10
Authorization: Bearer {{BearerToken}}

###

# PUT Assign a license seat to a user (use the license id from the create response, and any user's id)
PUT {{Web_HostAddress}}/api/SoftwareLicenses/1/assign?userId=3a8b4c2d-1111-2222-3333-444455556666
Authorization: Bearer {{BearerToken}}

###

# PUT Revoke a license seat (Result pattern: 200 on success, 400 { errors: [...] } on failure)
PUT {{Web_HostAddress}}/api/SoftwareLicenses/1/revoke?userId=<UserIdHere>
Authorization: Bearer {{BearerToken}}


###

# POST Create an Asset (Admin/LicenseManager only)
POST {{Web_HostAddress}}/api/Assets
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "model": "Dell Latitude 7440",
  "serialNumber": "SN-0001"
}

###

# GET Assets (paginated)
GET {{Web_HostAddress}}/api/Assets?PageNumber=1&PageSize=10
Authorization: Bearer {{BearerToken}}

###

# PUT Update an Asset
PUT {{Web_HostAddress}}/api/Assets/1
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "id": 1,
  "model": "Dell Latitude 7450",
  "serialNumber": "SN-0001-REV2"
}

###

# PUT Assign an Asset to a user
PUT {{Web_HostAddress}}/api/Assets/1/assign?userId=<UserIdHere>
Authorization: Bearer {{BearerToken}}

###

# PUT Unassign an Asset
PUT {{Web_HostAddress}}/api/Assets/1/unassign
Authorization: Bearer {{BearerToken}}

###

# DELETE an Asset (Admin only — soft delete, row is retained with IsDeleted = true)
DELETE {{Web_HostAddress}}/api/Assets/1
Authorization: Bearer {{BearerToken}}


### =========================================================================

# GET WeatherForecast
GET {{Web_HostAddress}}/api/WeatherForecasts
Authorization: Bearer {{BearerToken}}

###

# GET TodoLists
GET {{Web_HostAddress}}/api/TodoLists
Authorization: Bearer {{BearerToken}}

###

# POST TodoLists
POST {{Web_HostAddress}}/api/TodoLists
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "Title": "Backlog"
}

